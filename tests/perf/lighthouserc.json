{
  "ci": {
    "collect": {
      "url": ["http://localhost/blog-noticias/public/", "http://localhost/blog-noticias/public/noticia/lima-abre-nuevos-espacios-peatonales-para-recuperar-la-vida-de-barrio"],
      "numberOfRuns": 3,
      "settings": {"formFactor": "mobile", "screenEmulation": {"mobile": true, "width": 360, "height": 640, "deviceScaleFactor": 1, "disabled": false}, "throttling": {"rttMs": 150, "throughputKbps": 1638.4, "cpuSlowdownMultiplier": 4}, "onlyCategories": ["performance", "accessibility"]}
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9}],
        "categories:accessibility": ["error", {"minScore": 1}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "total-blocking-time": ["error", {"maxNumericValue": 200}],
        "total-byte-weight": ["error", {"maxNumericValue": 1048576}]
      }
    },
    "upload": {"target": "filesystem", "outputDir": "work/lighthouse"}
  }
}
