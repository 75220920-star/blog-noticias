{
  "name": "pulso-blog-noticias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node bin/build.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y --project=chromium",
    "test:mobile": "playwright test tests/mobile",
    "test:perf": "lhci autorun --config=tests/perf/lighthouserc.json",
    "test:load": "k6 run tests/perf/load.js",
    "lint:css": "stylelint public/assets/app.css",
    "test:all": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^38.0.0"
  }
}
